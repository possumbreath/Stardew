{	"LogName": "Weekly Dialogue Edits w/ Seasonals",
	"Action": "EditData",
	"Target": "Characters/Dialogue/Harvey",
	"Entries": {

		//Weekly Dialogue + Seasonals
		//every day decides first between generic and seasonal dialogue, and then a random option from the appropriate pool for that dialogue
		//Generic daily lines are day of week specific, seasonal lines are season specific only but vary more by heart level
		//It's very unlikely a person would see every single option on one playthrough; the idea is replayability for people like me who have a lot of files
		//And for people who play one file for a long time, it's possible they'll still be finding new dialogue several in-game years in, instead of it getting stale

		"{{TodaysDate}}": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:1}}],[LocalizedText Strings/{{ModId}}:Weekly.0.{{Random:1,2,3,4}}]}}",
		"{{TodaysDate}}2": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:1,2}}],[LocalizedText Strings/{{ModId}}:Weekly.2.{{Random:1,2,3,4}}]}}",
		"{{TodaysDate}}4": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:3,4}}],[LocalizedText Strings/{{ModId}}:Weekly.4.{{Random:1,2,3,4}}]}}",
		"{{TodaysDate}}6": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:5,6}}],[LocalizedText Strings/{{ModId}}:Weekly.6.{{Random:1,2,3,4}}]}}",
		"{{TodaysDate}}8": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:7,8}}],[LocalizedText Strings/{{ModId}}:Weekly.8.{{Random:1,2,3,4}}]}}",
		"{{TodaysDate}}10": "{{Random:[LocalizedText Strings/{{ModId}}:{{TodaysDate}}.{{Random:8,9,10}}],[LocalizedText Strings/{{ModId}}:Weekly.10.{{Random:1,2,3,4}}]}}",

		//Question keys

		"TH2Yes": "[LocalizedText Strings/{{ModId}}:TH2Yes]",
