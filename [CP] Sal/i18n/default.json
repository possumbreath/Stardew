	//IF YOU USE AN AI OR A PROGRAM TO TRANSLATE AND IT MESSES THOSE UP, YOU'RE ON YOUR OWN, BUCKAROO!

	"Mon.1": "PLACEHOLDER",
	"Mon.2": "PLACEHOLDER",
	"Mon.3": "PLACEHOLDER",
	"Mon.4": "PLACEHOLDER",
	"Mon.5": "PLACEHOLDER",
	"Mon.6": "PLACEHOLDER",
